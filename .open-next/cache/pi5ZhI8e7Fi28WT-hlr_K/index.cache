.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z\"></path></svg></a></div></div><h3 class=\"text-xl font-black uppercase tracking-tight leading-tight\">DeepGraph</h3><p class=\"text-sm font-bold leading-relaxed flex-1 opacity-75\">Graph neural network framework for social network analysis and anomaly detection at scale.</p><div class=\"flex flex-wrap gap-1.5 pt-2 border-t-2 border-neo-ink\"><span class=\"neo-tag\">Python</span><span class=\"neo-tag\">PyTorch</span><span class=\"neo-tag\">Neo4j</span><span class=\"neo-tag\">FastAPI</span></div></div></div></div></div></section><section id=\"hardware\" class=\"neo-section neo-section-yellow\"><div class=\"mx-auto max-w-7xl\"><div class=\"mb-14\" style=\"opacity:0;transform:translateY(32px)\"><span class=\"neo-label text-xs mb-3 block\">02 / Hardware Builds</span><h2 class=\"neo-display text-[clamp(3rem,8vw,6rem)] uppercase\" style=\"display:inline-block\">Hardware</h2><p class=\"mt-4 text-xl font-bold max-w-lg\">Soldering iron meets source code — physical builds that blur software and silicon.</p></div><div class=\"grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3\"><div class=\"neo-card flex flex-col p-0 overflow-hidden\" style=\"opacity:0;transform:translateY(32px)\"><div class=\"flex items-center gap-3 px-5 py-3 border-b-4 border-neo-ink\" style=\"background:var(--neo-secondary)\"><span class=\"text-3xl leading-none\">⌨️</span><h3 class=\"font-black text-base uppercase leading-tight tracking-tight\">Custom Mechanical Keyboard</h3></div><div class=\"flex flex-col flex-1 p-5 gap-4\"><div class=\"flex flex-wrap gap-1.5\"><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">65% layout</span><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">Gateron Black</span><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">Brass plate</span></div><p class=\"text-sm font-bold leading-relaxed flex-1 opacity-75\">Hand-wired 65% layout with Gateron Black switches, brass weight, and QMK firmware with RGB underglow.</p><div class=\"flex flex-wrap gap-1.5 pt-2 border-t-2 border-neo-ink\"><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">QMK</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">C</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">PCB Design</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">3D Print</span></div></div></div><div class=\"neo-card flex flex-col p-0 overflow-hidden\" style=\"opacity:0;transform:translateY(32px)\"><div class=\"flex items-center gap-3 px-5 py-3 border-b-4 border-neo-ink\" style=\"background:var(--neo-muted)\"><span class=\"text-3xl leading-none\">🔲</span><h3 class=\"font-black text-base uppercase leading-tight tracking-tight\">FPGA Neural Accelerator</h3></div><div class=\"flex flex-col flex-1 p-5 gap-4\"><div class=\"flex flex-wrap gap-1.5\"><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">Artix-7 FPGA</span><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">INT8 quant</span><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">PCIe Gen3</span></div><p class=\"text-sm font-bold leading-relaxed flex-1 opacity-75\">Custom FPGA-based inference engine running quantized transformer models at 10× CPU speed.</p><div class=\"flex flex-wrap gap-1.5 pt-2 border-t-2 border-neo-ink\"><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">VHDL</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">Xilinx</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">Python</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">ONNX</span></div></div></div><div class=\"neo-card flex flex-col p-0 overflow-hidden\" style=\"opacity:0;transform:translateY(32px)\"><div class=\"flex items-center gap-3 px-5 py-3 border-b-4 border-neo-ink\" style=\"background:var(--neo-accent)\"><span class=\"text-3xl leading-none\">💡</span><h3 class=\"font-black text-base uppercase leading-tight tracking-tight\">Ambient RGB Bias Light</h3></div><div class=\"flex flex-col flex-1 p-5 gap-4\"><div class=\"flex flex-wrap gap-1.5\"><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">WS2812B LEDs</span><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">60fps capture</span><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">USB HID</span></div><p class=\"text-sm font-bold leading-relaxed flex-1 opacity-75\">Raspberry Pi powered LED strips that mirror screen content for immersive computing.</p><div class=\"flex flex-wrap gap-1.5 pt-2 border-t-2 border-neo-ink\"><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">Raspberry Pi</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">Python</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">OpenCV</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">LED</span></div></div></div><div class=\"neo-card flex flex-col p-0 overflow-hidden\" style=\"opacity:0;transform:translateY(32px)\"><div class=\"flex items-center gap-3 px-5 py-3 border-b-4 border-neo-ink\" style=\"background:var(--neo-secondary)\"><span class=\"text-3xl leading-none\">🕰️</span><h3 class=\"font-black text-base uppercase leading-tight tracking-tight\">DIY Nixie Tube Clock</h3></div><div class=\"flex flex-col flex-1 p-5 gap-4\"><div class=\"flex flex-wrap gap-1.5\"><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">IN-14 tubes</span><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">GPS sync</span><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">CNC enclosure</span></div><p class=\"text-sm font-bold leading-relaxed flex-1 opacity-75\">Vintage Nixie IN-14 tube clock with GPS synchronisation and custom PCB with HV supply.</p><div class=\"flex flex-wrap gap-1.5 pt-2 border-t-2 border-neo-ink\"><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">KiCad</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">STM32</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">HV PSU</span><span class=\"neo-tag\" style=\"background:var(--neo-muted)\">GPS</span></div></div></div><div class=\"neo-card flex flex-col p-0 overflow-hidden\" style=\"opacity:0;transform:translateY(32px)\"><div class=\"flex items-center gap-3 px-5 py-3 border-b-4 border-neo-ink\" style=\"background:var(--neo-muted)\"><span class=\"text-3xl leading-none\">🖥️</span><h3 class=\"font-black text-base uppercase leading-tight tracking-tight\">Compute Cluster</h3></div><div class=\"flex flex-col flex-1 p-5 gap-4\"><div class=\"flex flex-wrap gap-1.5\"><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">6× Pi 5</span><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">Coral USB TPU</span><span class=\"text-[10px] font-black uppercase tracking-widest border-2 border-neo-ink px-2 py-0.5 bg-neo-bg\">10Gbps fabric</span></div><p class=\"text-sm font-bold leading-relaxed flex-1 opacity-75\">6-node Raspberry Pi 5 cluster running Kubernetes with distributed GPU workloads via Coral TPUs.</p><div class=\"flex flex-wrap gap-1.5 pt-2 border-t-2 border-neo-ink\"><span class=\"neo-tag\" style=\"background:var(--neo-muted)